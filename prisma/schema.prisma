generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Client Master Data (from RAW DATA sheets) ───
model Client {
  id              String   @id @default(cuid())
  clientCode      String   @unique
  clientName      String
  mobileNumber    String?
  email           String?
  concernedPerson String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projects       Project[]
  whatsappUsers  WhatsAppUser[]
}

// ─── Project Data (from RAW DATA + NEW DASH) ───
model Project {
  id              String   @id @default(cuid())
  clientId        String
  projectName     String
  proposalType    String?
  teamLeaderId    String?
  teamEngaged     String?
  setSentVia      String?

  // Financial amounts (in Cr)
  termLoanAmt     Float    @default(0)
  ccAmt           Float    @default(0)
  bgAmt           Float    @default(0)
  lcAmt           Float    @default(0)
  odAmt           Float    @default(0)
  lapAmt          Float    @default(0)
  lcWcdlAmt       Float    @default(0)
  totalLoanAmount Float    @default(0)
  loanAppliedFor  Float    @default(0)

  // Attachment & codes
  attachmentUrl   String?
  clientJobCode   String?
  mailStatus      String?

  // Overall completion
  completionPct   Float    @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client       @relation(fields: [clientId], references: [id])
  teamLeader      TeamLeader?  @relation(fields: [teamLeaderId], references: [id])
  steps           ProjectStep[]
  banks           ProjectBank[]
}

// ─── Project Steps (from NEW DASH - Step columns) ───
model ProjectStep {
  id          String   @id @default(cuid())
  projectId   String
  stepNumber  Int
  stepName    String
  status      String   @default("pending")
  dateValue   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id])
}

// ─── Project Bank Details (from RAW DATA2) ───
model ProjectBank {
  id                    String   @id @default(cuid())
  projectId             String
  bankName              String
  branchName            String?
  bankRelationshipMgr   String?
  loanAmount            Float    @default(0)
  attachment            String?
  bankAndBranch         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project               Project  @relation(fields: [projectId], references: [id])
}

// ─── Team Leader ───
model TeamLeader {
  id                    String   @id @default(cuid())
  name                  String
  mobileNumber          String?
  totalProjectsInHand   Int      @default(0)
  workCompletionPct     Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  projects     Project[]
  whatsappUsers WhatsAppUser[]
}

// ─── WhatsApp User Registration ───
model WhatsAppUser {
  id            String    @id @default(cuid())
  phone         String    @unique
  name          String?
  role          String    @default("client")
  clientId      String?
  teamLeaderId  String?
  isRegistered  Boolean   @default(false)
  registeredAt  DateTime?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client?      @relation(fields: [clientId], references: [id])
  teamLeader    TeamLeader?  @relation(fields: [teamLeaderId], references: [id])
  chatMessages  ChatMessage[]
}

// ─── Chat Message Log ───
model ChatMessage {
  id              String   @id @default(cuid())
  whatsappUserId  String
  direction       String
  messageText     String?
  messageType     String   @default("text")
  payload         String?
  createdAt       DateTime @default(now())

  whatsappUser WhatsAppUser @relation(fields: [whatsappUserId], references: [id])
}

// ─── Maytapi Configuration ───
model MaytapiConfig {
  id            String   @id @default(cuid())
  apiKey        String
  productId     String
  phoneId       String?
  webhookUrl    String?
  isActive      Boolean  @default(true)
  phoneNumber   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Google Sheets Sync Log ───
model SyncLog {
  id            String   @id @default(cuid())
  sheetName     String
  status        String
  recordsSynced Int     @default(0)
  errors        String?
  syncAt        DateTime @default(now())
}
