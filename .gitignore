# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER commit real .env
.env
.env.local
.env.production
.env.vercel

# vercel
.vercel

# database files - NEVER commit SQLite DB
db/
*.db

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
dev.log
server.log

# internal/sandbox files
local-*
.claude
.z-ai-config
.zscripts/
agent-ctx/
skills/
examples/
download/
upload/
mini-services/
