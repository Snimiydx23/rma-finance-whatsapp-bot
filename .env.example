# REQUIRED: PostgreSQL connection string
# Get free PostgreSQL at https://neon.tech
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/rma_finance?sslmode=require
DATABASE_URL= postgresql://neondb_owner:****************@ep-delicate-mouse-apq98td1-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# REQUIRED: Your app URL (used for internal API calls on Vercel)
# Example: https://rma-finance-bot.vercel.app
NEXT_PUBLIC_APP_URL= https://rma-finance-whatsapp-bot.vercel.app/
